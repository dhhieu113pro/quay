{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quay",
  "version": "0.1.0",
  "identifier": "dev.quay.wslc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quay",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Hieu Dam",
    "copyright": "Copyright © 2026 Hieu Dam",
    "category": "DeveloperTool",
    "shortDescription": "A dock for WSL containers",
    "longDescription": "Quay is a desktop for WSL containers (wslc). The WebView talks to a C# sidecar on Microsoft.WSL.Containers — pull images, run containers, exec, logs, GPU and ports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/quay-host"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
