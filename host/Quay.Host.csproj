<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Official WSLC sample is net8.0-windows10.0.19041.0. wslcsdkcs.dll
         was built against Microsoft.Windows.SDK.NET 10.0.26100.79, so a
         22621 TFM trips CS1705. Pin the 26100 targeting pack. -->
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Quay.Host</RootNamespace>
    <AssemblyName>quay-host</AssemblyName>
    <Version>0.1.0</Version>
    <Company>Hieu Dam</Company>
    <Product>Quay</Product>
    <Description>C# sidecar for Quay — Microsoft.WSL.Containers</Description>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WSL.Containers" Version="2.9.3" />
  </ItemGroup>
</Project>
